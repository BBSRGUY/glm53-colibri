+def _glm53_geometry(config, context, _model_dir):
+    """GLM-5.3-Flash: hybrid KDA/DSA attention with mHC residual streams."""
+    layers = _required_int(config, "num_hidden_layers", "glm53")
+    experts = _required_int(config, "n_routed_experts", "glm53")
+    kv_lora = _required_int(config, "kv_lora_rank", "glm53")
+    rope = _optional_int(config, "qk_rope_head_dim", 0)          # 0 under mla_use_nope
+    heads = _required_int(config, "num_attention_heads", "glm53")
+    nope = _required_int(config, "qk_nope_head_dim", "glm53")
+    value = _required_int(config, "v_head_dim", "glm53")
+    hc = max(1, _optional_int(config, "hc_mult", 1))
+
+    kinds = config.get("layer_types")
+    if isinstance(kinds, list) and kinds:
+        full = sum(kind != "linear_attention" for kind in kinds[:layers])
+        linear = sum(kind == "linear_attention" for kind in kinds[:layers])
+    else:                                                        # no layer_types: assume all full
+        full, linear = layers, 0
+    full += 1                                                    # the MTP block keeps its own KV
+
+    # per-token, per-full-layer latent row
+    state = full * context * (kv_lora + rope) * 4
+
+    # DSA indexer key cache, on the full layers that carry one
+    index_dim = _optional_int(config, "index_head_dim", 0)
+    if index_dim and config.get("_colibri_indexer_present", False):
+        state += full * context * index_dim * 4
+        if _optional_int(config, "index_kpool", 0) > 1:
+            state += full * context * index_dim * 4              # k-pool also caches gate logits
+
+    # KDA recurrent state + conv windows: constant in context
+    fixed = 0
+    la = config.get("linear_attn_config") or {}
+    if linear and isinstance(la, dict):
+        kh = _optional_int(la, "num_heads", 0)
+        khd = _optional_int(la, "head_dim", 0)
+        conv = _optional_int(la, "short_conv_kernel_size", 0)
+        fixed = linear * (kh * khd * khd + 3 * kh * khd * conv) * 4
+
+    workspace = hc * context * heads * (nope + value) * 4
+    return PlannerGeometry(state, fixed, workspace, experts)
+
