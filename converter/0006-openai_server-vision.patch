+def content_text_mm(content, param, image_out, tokens_per_image, tokens_per_video=0):
+    """content_text(), except image parts render as a placeholder run.
+
+    The run is `tokens_per_image` copies of <|image|>, which the ENGINE later binds
+    to the sidecar's rows by scanning for image_token_id. The server deliberately
+    does not compute token offsets: that would mean a second tokenizer here, kept
+    in step with the engine's -- exactly the kind of seam this port keeps paying for.
+    """
+    if image_out is None:
+        return content_text(content, param)
+    if isinstance(content, str):
+        return content
+    if not isinstance(content, list):
+        raise APIError(400, "Message content must be a string or an array of parts.", param)
+    parts = []
+    for index, part in enumerate(content):
+        if not isinstance(part, dict):
+            raise APIError(400, "Each content part must be an object.", f"{param}.{index}")
+        kind = part.get("type")
+        if kind in ("text", "input_text"):
+            if not isinstance(part.get("text"), str):
+                raise APIError(400, "Text content parts require a string `text` field.",
+                               f"{param}.{index}.text")
+            parts.append(part["text"])
+        elif kind in ("image_url", "input_image"):
+            src = part.get("image_url")
+            if isinstance(src, dict):
+                src = src.get("url")
+            src = src or part.get("image")
+            if not isinstance(src, str) or not src:
+                raise APIError(400, "Image parts require a url (data:, http(s):, or a path).",
+                               f"{param}.{index}.image_url")
+            image_out.append(("image", src))
+            parts.append(IMAGE_BEGIN + IMAGE_TOK * tokens_per_image + IMAGE_END)
+        elif kind in ("video_url", "input_video"):
+            src = part.get("video_url")
+            if isinstance(src, dict):
+                src = src.get("url")
+            src = src or part.get("video")
+            if not isinstance(src, str) or not src:
+                raise APIError(400, "Video parts require a url or path.",
+                               f"{param}.{index}.video_url")
+            if not tokens_per_video:
+                raise APIError(400, "This build cannot encode video.", f"{param}.{index}")
+            image_out.append(("video", src))
+            parts.append(VIDEO_BEGIN + VIDEO_TOK * tokens_per_video + VIDEO_END)
+        else:
+            raise APIError(400, f"Unsupported content part type: {kind!r}.",
+                           f"{param}.{index}", "unsupported_content_type")
+    return "".join(parts)
+
+
