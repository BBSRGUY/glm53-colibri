+IMAGE_BEGIN, IMAGE_TOK, IMAGE_END = "<|begin_of_image|>", "<|image|>", "<|end_of_image|>"
+VIDEO_BEGIN, VIDEO_TOK, VIDEO_END = "<|begin_of_video|>", "<|video|>", "<|end_of_video|>"
+
